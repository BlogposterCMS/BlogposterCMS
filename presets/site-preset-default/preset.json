{
  "schemaVersion": 1,
  "id": "site-preset-default",
  "name": "Default",
  "version": "1.0.0",
  "developer": "Blogposter Team",
  "components": [
    { "id": "primary", "name": "Primary button", "type": "button", "props": { "label": "Continue" } },
    { "id": "secondary", "name": "Secondary button", "type": "button", "props": { "label": "Cancel", "variant": "secondary" } },
    { "id": "input", "name": "Input", "type": "input", "props": { "label": "Name", "placeholder": "Enter your name" } },
    { "id": "textarea", "name": "Text area", "type": "textarea", "props": { "label": "Message" } },
    { "id": "dropdown", "name": "Dropdown", "type": "select", "props": { "label": "Choose", "options": ["First", "Second"] } },
    { "id": "multiselect", "name": "Multiple selection", "type": "multiselect", "props": { "label": "Choose several", "options": ["First", "Second"] } },
    { "id": "checkbox", "name": "Checkbox", "type": "checkbox", "props": { "label": "Accept" } },
    { "id": "radio", "name": "Radio group", "type": "radio", "props": { "label": "Choose one", "options": ["First", "Second"] } },
    { "id": "switch", "name": "Switch", "type": "switch", "props": { "label": "Enable" } },
    { "id": "tabs", "name": "Tabs", "type": "tabs", "props": { "tabs": [{ "label": "Overview", "content": "Overview content" }, { "label": "Details", "content": "Details content" }] } },
    { "id": "popover", "name": "Popover", "type": "popover", "props": { "label": "More", "content": "Additional information" } },
    { "id": "tooltip", "name": "Tooltip", "type": "tooltip", "props": { "label": "Help", "content": "Helpful explanation" } }
  ],
  "builderSettings": {
    "layoutMode": "free",
    "gap": 0,
    "padding": 0,
    "sceneBackground": "#FFFFFF"
  },
  "colorScheme": {
    "id": "color-scheme-default",
    "name": "Default",
    "colors": [
      { "id": "default-1", "name": "Primary", "value": "#171717" },
      { "id": "default-2", "name": "Text", "value": "#111827" },
      { "id": "default-3", "name": "Background", "value": "#FFFFFF" },
      { "id": "default-4", "name": "Muted", "value": "#6B7280" },
      { "id": "default-5", "name": "Accent", "value": "#2563EB" }
    ]
  },
  "fontPackage": {
    "id": "font-package-default",
    "name": "Default",
    "roles": {}
  },
  "pageDemos": [
    {
      "id": "starter",
      "name": "Starter",
      "scene": {
        "title": "Hero",
        "background": "#FFFFFF"
      },
      "elements": [
        { "presetId": "text.heading", "x": 1, "y": 120, "w": 7, "h": 96 },
        { "presetId": "text.paragraph", "x": 1, "y": 230, "w": 6, "h": 88 },
        { "presetId": "button.primary", "x": 1, "y": 335, "w": 3, "h": 56 }
      ]
    }
  ]
