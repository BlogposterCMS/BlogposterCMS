{
  "watch": [
    "app.js",
    "config",
    "library",
    "modules",
    "mother",
    "widgets"
  ],
  "ext": "js,json,mjs,cjs,ts",
  "ignore": [
    "data/**/*",
    "**/*.sqlite",
    "install.lock",
    "server.log",
    "public/build/**/*",
    "public/assets/css/**/*",
    "apps/**/assets/css/**/*",
    "mother/modules/notificationManager/integrationsRegistry.json",
    "mother/modules/notificationManager/**/*.log",
    "mother/modules/databaseManager/placeholders/placeholderData.json"
  ]
}
