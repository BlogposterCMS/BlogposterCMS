#!/usr/bin/env bash
set -Eeuo pipefail

# Host provisioning only. End users install subsequent releases inside the CMS.
[[ "$(id -u)" == 0 ]] || { echo 'CORE_UPDATE_SETUP_ROOT_REQUIRED'; exit 1; }
[[ -x /usr/bin/node ]] && /usr/bin/node -e 'if(+process.versions.node.split(".")[0]<24)process.exit(1)' || {
  echo 'CORE_UPDATE_SETUP_NODE_REQUIRED: install Node.js 24 or newer at /usr/bin/node'; exit 1;
}
for command in systemctl getent groupadd install gh flock docker; do
  command -v "$command" >/dev/null || { echo "CORE_UPDATE_SETUP_TOOL_MISSING: $command"; exit 1; }
done
asset_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# Verify every executable/configuration asset before granting host privileges.
for asset in download-update-image.js update-agent.js blogposter-update blogposter-update-agent.service blogposter-updates.compose.yml; do
  gh attestation verify "$asset_dir/$asset" --bundle "$asset_dir/update-control.bundle.json" \
    --repo BlogposterCMS/BlogposterCMS \
    --signer-workflow BlogposterCMS/BlogposterCMS/.github/workflows/release.yml >/dev/null
done
[[ -f /opt/blogposter/updater.conf && ! -L /opt/blogposter/updater.conf ]] || { echo 'CORE_UPDATE_SETUP_CONFIG_REQUIRED'; exit 1; }

# Reuse the updater's strict KEY=VALUE parser; never source runtime environment files.
source "$asset_dir/blogposter-update"
load_config /opt/blogposter/updater.conf
prepare_environment
# Never replace the executor while its existing updater owns an installation.
exec 8>"$BLOGPOSTER_STATE_DIR/update.lock"
flock -n 8 || { echo 'CORE_UPDATE_SETUP_BUSY: an update is running; retry after completion'; exit 1; }
[[ -n "${BLOGPOSTER_COMPOSE_ENV_FILE:-}" && -f "$BLOGPOSTER_COMPOSE_ENV_FILE" && ! -L "$BLOGPOSTER_COMPOSE_ENV_FILE" ]] || {
  echo 'CORE_UPDATE_SETUP_COMPOSE_ENV_REQUIRED'; exit 1;
}
getent group blogposter-updater >/dev/null || groupadd --system blogposter-updater
updater_gid="$(getent group blogposter-updater | cut -d: -f3)"
[[ "$updater_gid" =~ ^[0-9]+$ ]] || { echo 'CORE_UPDATE_SETUP_GROUP_INVALID'; exit 1; }
install -d -m 0755 /opt/blogposter/bin
install -m 0755 "$asset_dir/blogposter-update" /opt/blogposter/bin/blogposter-update
install -m 0644 "$asset_dir/download-update-image.js" /opt/blogposter/bin/download-update-image.js
install -m 0644 "$asset_dir/update-agent.js" /opt/blogposter/bin/update-agent.js
install -m 0644 "$asset_dir/blogposter-updates.compose.yml" /opt/blogposter/blogposter-updates.compose.yml
install -m 0644 "$asset_dir/blogposter-update-agent.service" /etc/systemd/system/blogposter-update-agent.service

set_owned_value() {
  local file="$1" key="$2" value="$3" temp
  temp="$(mktemp "${file}.XXXXXX")"
  awk -v key="$key" '$0 !~ "^" key "="' "$file" > "$temp"
  printf '\n%s=%s\n' "$key" "$value" >> "$temp"
  chmod --reference="$file" "$temp"
  chown --reference="$file" "$temp"
  mv -f -- "$temp" "$file"
}
set_owned_value /opt/blogposter/updater.conf BLOGPOSTER_COMPOSE_UPDATES_FILE /opt/blogposter/blogposter-updates.compose.yml
set_owned_value "$BLOGPOSTER_COMPOSE_ENV_FILE" BLOGPOSTER_UPDATER_GID "$updater_gid"
load_config /opt/blogposter/updater.conf
prepare_environment
compose_run config --quiet
systemctl daemon-reload
systemctl enable blogposter-update-agent.service
systemctl restart blogposter-update-agent.service
for attempt in {1..20}; do
  [[ -S /run/blogposter-updater/control.sock ]] && break
  sleep 1
done
[[ -S /run/blogposter-updater/control.sock ]] || { echo 'CORE_UPDATE_SETUP_SOCKET_MISSING'; exit 1; }
# Rebind even when Compose configuration is unchanged: older service units
# removed the runtime directory on restart, leaving existing mounts orphaned.
# This affects only the CMS service and preserves its named data/media volumes.
compose_run up -d --no-deps --force-recreate "$BLOGPOSTER_SERVICE"
wait_healthy || { echo 'CORE_UPDATE_SETUP_READINESS_FAILED'; exit 1; }
# Readiness alone does not prove the non-root CMS can reach the privileged socket.
docker exec "$(container_id)" node -e '
const http = require("http");
const req = http.get({socketPath:"/run/blogposter-updater/control.sock",path:"/status"}, res => {
  let body=""; res.on("data", chunk => body+=chunk);
  res.on("end", () => { try { if(res.statusCode!==200 || JSON.parse(body).configured!==true) process.exit(1); } catch { process.exit(1); } });
});
req.setTimeout(8000,()=>req.destroy(new Error("timeout")));
req.on("error",()=>process.exit(1));
' || { echo 'CORE_UPDATE_SETUP_CONTAINER_ACCESS_FAILED'; exit 1; }
echo 'CORE_UPDATE_SETUP_COMPLETE: update controls are connected.'
